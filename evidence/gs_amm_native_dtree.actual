WITH s AS (SELECT gs_amm_status() AS v),
parsed AS (
  SELECT split_part(split_part(v, 'dtree_last_feedback_grant_mb=', 2), ' ', 1)::double precision AS completed_grant_mb,
         split_part(split_part(v, 'dtree_last_feedback_observed_work_mem_kb=', 2), ' ', 1)::double precision AS observed_work_mem_kb,
         split_part(split_part(v, 'dtree_last_feedback_spill_bytes=', 2), ' ', 1)::bigint AS spill_bytes
  FROM s
)
SELECT completed_grant_mb, observed_work_mem_kb, spill_bytes,
       completed_grant_mb > 0 AND completed_grant_mb < 4 AS actual_grant_below_documented_min
FROM parsed;
 completed_grant_mb | observed_work_mem_kb | spill_bytes | actual_grant_below_documented_min 

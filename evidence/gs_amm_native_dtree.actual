WITH s AS (SELECT gs_amm_status() AS v)
SELECT split_part(split_part(v, 'native_last_event_granted_kb=', 2), ' ', 1)::integer AS granted_kb,
       split_part(split_part(v, 'native_last_event_raw_bounds_kb=', 2), ' ', 1) AS raw_bounds_kb,
       split_part(split_part(v, 'native_last_event_memory_mode=', 2), ' ', 1) AS memory_mode,
       split_part(split_part(v, 'native_last_event_leaf_id=', 2), ' ', 1) AS leaf_id
FROM s;
 granted_kb |     raw_bounds_kb      | memory_mode |       leaf_id       
------------+------------------------+-------------+---------------------
          0 | 801.000,801.000,64.000 | none        | 6487479820160041854
(1 row)

WITH s AS (SELECT gs_amm_status() AS v)
SELECT position('native_eligible_count=1' in v) > 0
   AND position('native_admit_count=1' in v) > 0
   AND position('native_release_count=1' in v) > 0
   AND position('native_active_grant_count=0' in v) > 0 AS native_lifecycle_ok,
       split_part(split_part(v, 'native_last_event_granted_kb=', 2), ' ', 1)::integer < 4096 AS below_documented_min
FROM s;
 native_lifecycle_ok | below_documented_min 
---------------------+----------------------
 t                   | t
